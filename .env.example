# Stellar Network Configuration
VITE_STELLAR_NETWORK=testnet
# VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Platform wallets (public keys only — safe for client)
# VITE_ADMIN_PUBLIC_KEY=GDHAGXZUWGJR6AQW25IU74J5JSU5HAKUMUY3SY4JNMJXNXEJCZM7WOAW
# VITE_TREASURY_PUBLIC_KEY=GDHAGXZUWGJR6AQW25IU74J5JSU5HAKUMUY3SY4JNMJXNXEJCZM7WOAW

# Soroban VAT refund registry (optional — not wired into dApp yet)
# Deploy from contracts/ — see contracts/README.md
# VITE_VAT_REFUND_CONTRACT_ID=C...

# Supabase Configuration (required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini AI Configuration (optional — powers AI Assistant + passport VIZ extraction)
# VITE_GEMINI_API_KEY=your_gemini_api_key

# Passport server fallback (default: enabled when client MRZ fails)
# VITE_PASSPORT_SERVER_FALLBACK=true

# EmailJS Configuration (optional)
# VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# ─── Local dev treasury (pnpm dev only — never exposed to browser) ───
# Used by vite-plugin-treasury-dev.ts when Edge Functions are not deployed.
# TREASURY_SECRET_KEY=S...
# TREASURY_PUBLIC_KEY=G...
# STELLAR_NETWORK=mainnet
# VITE_USE_SUPABASE_TREASURY=true   # force Supabase edge fn in dev (after deploy)

# ─── Supabase Edge Function secrets ───
# Set via: supabase secrets set KEY=value --project-ref YOUR_REF
#
# Treasury payouts (treasury-payout function — NEVER commit the secret):
# TREASURY_SECRET_KEY=S...
# TREASURY_PUBLIC_KEY=G...
# ADMIN_PUBLIC_KEY=G...
# STELLAR_NETWORK=mainnet
#
# Passport verification (verify-passport function):
# PERSONA_API_KEY=persona_sandbox_...
# PERSONA_INQUIRY_TEMPLATE_ID=itmpl_...
#
# Veriff (https://veriff.com):
# VERIFF_API_KEY=...
# VERIFF_API_SECRET=...
# VERIFF_CALLBACK_URL=https://your-domain.com/api/veriff-webhook
